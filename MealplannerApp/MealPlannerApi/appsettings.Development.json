{
  "MySql": {
    "ServerVersion": "8.0.36"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "MealPlannerApi",
    "Audience": "MealPlannerFrontend",
    "ExpiresHours": 8
  },
  "Gemini": {
    "Model": "gemini-1.5-flash"
  },
  "MealDataRefresh": {
    "Enabled": true,
    "InitialDelayMinutes": 10,
    "IntervalDays": 7,
    "MealsPerCategory": 8,
    "MinimumCatalogSize": 180,
    "EnrichLimit": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
